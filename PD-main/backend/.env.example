PORT=5000

# ── MongoDB Atlas (Optional) ──────────────────────────────────────────────
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/asdse_db?retryWrites=true&w=majority

# ── LLM Gateway Configuration ────────────────────────────────────────────
# Select provider: deterministic | openai | groq | gemini | claude | ollama
LLM_PROVIDER=deterministic

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini
# GEMINI_API_KEY=AI...
# GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-haiku-20240307

# Ollama (Local)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3

# ── GitHub OAuth Configuration ───────────────────────────────────────────
# Required for connecting external repositories directly from GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
